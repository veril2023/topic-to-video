# 统一换行符，避免 Windows / macOS / Linux 协作时整个文件"全改了一遍"
# 仓库里一律存 LF；文本文件检出时也保持 LF（本项目的脚本和文档都不依赖 CRLF）
* text=auto eol=lf

# 明确标成文本的（防止某些平台把它们当二进制）
*.py    text eol=lf
*.js    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.srt   text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf

# 二进制：不要让 git 尝试合并或转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.mp3   binary
*.mp4   binary
*.wav   binary
*.woff  binary
*.woff2 binary

# Windows 批处理必须 CRLF，否则 cmd 解析会出错
*.bat   text eol=crlf
*.cmd   text eol=crlf
